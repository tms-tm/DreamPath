{
  "dataString": "\u003c!DOCTYPE html\u003e\u003chtml lang=\"en\"\u003e\u003chead\u003e\u003c/head\u003e\u003cbody class=\"min-h-screen flex bg-[#FAF8F5] text-[#1E232A]\"\u003e\u003csvg class=\"inline-defs-container\" aria-hidden=\"true\" style=\"position:absolute;width:0;height:0;overflow:hidden\"\u003e\u003c/svg\u003e\n\u003cmeta charset=\"utf-8\"\u003e\n\u003cmeta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"\u003e\n\u003ctitle\u003eDreamPath - Student Career Exploration Dashboard\u003c/title\u003e\n\u003c!-- Google Fonts: Plus Jakarta Sans --\u003e\n\u003clink href=\"https://fonts.googleapis.com\" rel=\"preconnect\"\u003e\n\u003clink crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"\u003e\n\u003clink href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;display=swap\" rel=\"stylesheet\"\u003e\n\u003c!-- Tailwind CSS v3 with Plugins --\u003e\n\u003cscript src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"\u003e\u003c/script\u003e\n\u003cscript\u003e\n    tailwind.config = {\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['\"Plus Jakarta Sans\"', 'sans-serif'],\n          },\n          colors: {\n            surface: {\n              DEFAULT: '#FAF8F5',\n              dim: '#F4EFE6',\n              card: '#FFFFFF',\n              subtle: '#F6F3ED',\n              border: '#EAE5DE',\n            },\n            sky: {\n              50: '#F0F7FF',\n              100: '#E0F0FE',\n              200: '#BAE0FD',\n              300: '#7DC4FA',\n              400: '#38A4F6',\n              500: '#0E86D4',\n              600: '#0269B3',\n            },\n            oat: {\n              50: '#FCFBF9',\n              100: '#F7F4EE',\n              200: '#EFE9DE',\n              300: '#E2D9C8',\n              700: '#685F51',\n              900: '#2A241B',\n            },\n            charcoal: {\n              DEFAULT: '#1E232A',\n              muted: '#626B7A',\n            }\n          },\n          boxShadow: {\n            soft: '0 2px 14px -3px rgba(42, 36, 27, 0.04), 0 1px 4px -1px rgba(42, 36, 27, 0.02)',\n            card: '0 8px 20px -4px rgba(40, 30, 20, 0.05), 0 2px 6px -2px rgba(40, 30, 20, 0.03)',\n            float: '0 12px 28px -6px rgba(14, 134, 212, 0.25), 0 4px 10px -2px rgba(14, 134, 212, 0.15)',\n          }\n        }\n      }\n    }\n  \u003c/script\u003e\n\u003c!-- BEGIN: Custom Style Definitions --\u003e\n\u003cstyle data-purpose=\"base-styling\"\u003e\n    body {\n      font-family: 'Plus Jakarta Sans', sans-serif;\n      background-color: #FAF8F5;\n      color: #1E232A;\n      -webkit-font-smoothing: antialiased;\n      -moz-osx-font-smoothing: grayscale;\n    }\n    /* Smooth custom scrollbars */\n    ::-webkit-scrollbar {\n      width: 6px;\n      height: 6px;\n    }\n    ::-webkit-scrollbar-track {\n      background: #FAF8F5;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: #D9D2C5;\n      border-radius: 9999px;\n    }\n    ::-webkit-scrollbar-thumb:hover {\n      background: #BFB5A2;\n    }\n  \u003c/style\u003e\n\u003cstyle data-purpose=\"hero-illustration\"\u003e\n    /* Subtle orbit float animation */\n    @keyframes subtleFloat {\n      0%, 100% { transform: translateY(0px) rotate(0deg); }\n      50% { transform: translateY(-5px) rotate(1deg); }\n    }\n    .animate-float {\n      animation: subtleFloat 7s ease-in-out infinite;\n    }\n  \u003c/style\u003e\n\u003c!-- END: Custom Style Definitions --\u003e\n\n\n\u003c!-- BEGIN: LeftSidebar --\u003e\n\u003caside class=\"w-60 flex-shrink-0 bg-[#F6F3ED] border-r border-[#EAE5DE] flex flex-col justify-between h-screen sticky top-0 px-4 py-6 select-none z-30\" data-purpose=\"desktop-sidebar\"\u003e\n\u003cdiv class=\"space-y-6\"\u003e\n\u003c!-- App Brand Logo --\u003e\n\u003cdiv class=\"flex items-center gap-2.5 px-2 py-1\"\u003e\u003csvg class=\"w-6 h-6 text-slate-800 shrink-0\" viewBox=\"0 0 24 24\" fill=\"currentColor\"\u003e\u003cpath d=\"M12 2L13.8 8.2L20 10L13.8 11.8L12 18L10.2 11.8L4 10L10.2 8.2L12 2Z\"\u003e\u003c/path\u003e\u003ccircle cx=\"19\" cy=\"5\" r=\"1.5\"\u003e\u003c/circle\u003e\u003ccircle cx=\"5\" cy=\"17\" r=\"1.5\"\u003e\u003c/circle\u003e\u003c/svg\u003e\u003cspan class=\"font-serif font-bold text-xl tracking-tight text-slate-900 whitespace-nowrap\"\u003e\u003cspan style=\"color: rgb(27, 28, 24); font-family: &quot;Plus Jakarta Sans&quot;; font-size: 18px; letter-spacing: -0.18px; white-space: normal; background-color: rgb(246, 244, 237);\"\u003eDream&nbsp;\u003c/span\u003e\u003cspan style=\"color: rgb(78, 96, 116); font-family: &quot;Plus Jakarta Sans&quot;; font-size: 18px; letter-spacing: -0.18px; white-space: normal; background-color: rgb(246, 244, 237);\"\u003ePath\u003c/span\u003e\u003c/span\u003e\u003c/div\u003e\n\u003c!-- User Mini Profile Pill --\u003e\n\u003cdiv class=\"bg-white/80 border border-[#E8E2D7] rounded-2xl p-2.5 flex items-center gap-3 shadow-xs\"\u003e\n\u003cdiv class=\"w-9 h-9 rounded-full bg-gradient-to-br from-[#BAE0FD] to-[#38A4F6] flex items-center justify-center text-[#0B4D78] font-bold text-sm shadow-inner\"\u003e\n          A\n        \u003c/div\u003e\n\u003cdiv class=\"overflow-hidden\"\u003e\n\u003ch4 class=\"text-xs font-bold text-[#1E232A] truncate\"\u003eAlex Rivera\u003c/h4\u003e\n\u003cp class=\"text-[11px] font-medium text-charcoal-muted truncate\"\u003eAurora Tier · Lv. 4\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Navigation Menu --\u003e\n\u003cnav class=\"space-y-1.5 pt-1\" data-purpose=\"sidebar-nav\"\u003e\n\u003c!-- Active Link: Home --\u003e\n\u003ca class=\"flex items-center gap-3 px-3.5 py-2.5 rounded-xl font-semibold text-sm bg-[#E0F0FE] text-[#0269B3] shadow-xs transition-colors\" href=\"#home\"\u003e\n\u003csvg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" viewBox=\"0 0 24 24\"\u003e\n\u003cpath d=\"M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6h-4v6H4a1 1 0 01-